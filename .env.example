# Vigía: copy to .env and fill what you need. `bun run demo` needs none of this.
# Defaults are in contracts/cli.md and src/config.ts.

# Global Fishing Watch, free for non-commercial use: https://globalfishingwatch.org/our-apis/
GFW_TOKEN=
# Only for the paid profiles (haiku, sonnet)
ANTHROPIC_API_KEY=

# Ollama on the home PC, over Tailscale (default http://pc-casa:11434)
VIGIA_LOCAL_URL=
# default qwen3:8b
VIGIA_LOCAL_MODEL=
# none | haiku | sonnet (default none): re-investigates "inconclusive" cases while the budget allows
VIGIA_ESCALATE_PROFILE=
# Monthly cap for the paid profiles, in USD (default 0, which blocks any paid call)
VIGIA_BUDGET_USD=

# live | replay | public (each command picks its own default)
VIGIA_MODE=
# default data/vigia.sqlite
VIGIA_DB=
# Europe/Madrid hour for the daily brief (default 8)
VIGIA_BRIEF_HOUR=
