# Vigía: AIS ingest (Digitraffic MQTT -> SQLite and data/raw), as a systemd user unit on the Pi.
#
#   mkdir -p ~/.config/systemd/user && cp deploy/vigia-ingest.service ~/.config/systemd/user/
#   systemctl --user daemon-reload && systemctl --user enable --now vigia-ingest
#   sudo loginctl enable-linger "$USER"     # start at boot, without a login session
#   journalctl --user -u vigia-ingest -f
#
# Expects the repo at ~/vigia. Digitraffic needs no key; Bun loads ~/vigia/.env from the working
# directory for VIGIA_DB, if set. It keeps 30 days of positions and raw archive.
# After 10 minutes without a connection it exits with an error, and Restart=always starts it again.

[Unit]
Description=Vigía AIS ingest
After=network-online.target
Wants=network-online.target

[Service]
WorkingDirectory=%h/vigia
ExecStart=%h/.bun/bin/bun run src/cli/ingest.ts
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
